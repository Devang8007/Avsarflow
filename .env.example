# =============================================================================
# OpportunityHub India — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Client-Side) Variables (Vite / Lovable Deployment)
# These are exposed in the client browser bundle. NEVER put secret keys here!
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# -----------------------------------------------------------------------------
# Backend Worker & GitHub Actions Secrets (Python Collector)
# Store these in GitHub Repository Secrets or server environment variables.
# NEVER commit real secret keys to source control!
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-here
COLLECTOR_TIMEOUT_SECONDS=20
COLLECTOR_USER_AGENT=OpportunityHubIndia-Bot/1.0 (+https://opportunityhub.in/crawler; transparent public recruitment indexer)
